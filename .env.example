# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AsistenRT

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM — Google Gemini (server-side only, jangan pakai NEXT_PUBLIC_ prefix)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Security
APP_SECRET=

# Feature Flags
# Set ke true untuk mengaktifkan Gemini. Default false = aman saat pertama deploy.
ENABLE_LLM_INTENT=false
ENABLE_LLM_FAQ_RAG=false
ENABLE_PDF_EXPORT=false
ENABLE_WHATSAPP=false
